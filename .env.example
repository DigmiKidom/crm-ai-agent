# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm-ai-agent

# Auth.js secret — generate your own with: npx auth secret
AUTH_SECRET=

# Google AI Studio key — powers the AI agent (onboarding -> landing page copy
# + pipeline generation, via Gemini). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed once Google sign-in is added (Phase 3)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend — needed for password reset and signup email verification.
# Get one at https://resend.com
RESEND_API_KEY=

# Base URL used to build links inside emails (reset/verify).
APP_URL=http://localhost:3000
