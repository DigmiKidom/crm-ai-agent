# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm-ai-agent

# Auth.js secret — generate your own with: npx auth secret
AUTH_SECRET=

# Google AI Studio key — powers the AI agent (onboarding -> landing page copy
# + pipeline generation, via Gemini). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed once Google sign-in is added (Phase 3)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend — needed for password reset and signup email verification.
# Get one at https://resend.com
RESEND_API_KEY=

# Sender address. The DOMAIN HERE MUST BE VERIFIED IN RESEND — a free-provider
# address (gmail.com, outlook.com, ...) will be rejected, because its SPF/DKIM
# records belong to that provider and not to you.
FROM_EMAIL=Ceramony <noreply@ceramony.co>

# Where replies go. Unlike FROM_EMAIL this can be any address, including Gmail,
# since it isn't what the mail is authenticated against. Leave blank to omit.
REPLY_TO_EMAIL=ceramony.general@gmail.com

# Shown as the sender name and in the email footer.
PRODUCT_NAME=Ceramony

# Base URL used to build links inside emails (reset/verify).
APP_URL=http://localhost:3000
