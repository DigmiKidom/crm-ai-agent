# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm-ai-agent

# Auth.js secret — generate your own with: npx auth secret
AUTH_SECRET=

# Google AI Studio key — powers the AI agent (onboarding -> landing page copy
# + pipeline generation, via Gemini). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Only needed once Google sign-in is added (Phase 3)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Resend — needed for password reset and signup email verification.
# Get one at https://resend.com
RESEND_API_KEY=

# Sender address. The DOMAIN HERE MUST BE VERIFIED IN RESEND — a free-provider
# address (gmail.com, outlook.com, ...) will be rejected, because its SPF/DKIM
# records belong to that provider and not to you.
FROM_EMAIL=Ceramony <noreply@ceramony.co>

# Where replies go. Unlike FROM_EMAIL this can be any address, including Gmail,
# since it isn't what the mail is authenticated against. Leave blank to omit.
REPLY_TO_EMAIL=ceramony.general@gmail.com

# Shown as the sender name and in the email footer.
PRODUCT_NAME=Ceramony

# Base URL used to build every link inside emails (reset/verify/invite/lead)
# AND the logo image src in the email header. In production this MUST be the
# real public HTTPS domain — Gmail/Outlook/Apple Mail fetch images and follow
# links from their own servers, not the recipient's browser, so leaving this
# at localhost (or any URL those clients can't reach) is why the logo won't
# render and links won't work once real mail goes out.
APP_URL=http://localhost:3000

# Upstash Redis — powers rate limiting on signup, login, password reset, and
# the public lead-capture endpoint (proxy.js + lib/rateLimit.js). Get a
# free database at https://console.upstash.com (REST API, not the Redis
# protocol URL). Without these, rate limiting is silently disabled — the app
# still works, those endpoints are just unthrottled, so set these before
# taking real public traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Stripe — powers the Pro plan (lib/stripe.js, app/api/billing/*). Get keys at
# https://dashboard.stripe.com/apikeys. STRIPE_PRICE_ID is the recurring
# price id for the Pro subscription (Product catalog → your price → API ID).
# STRIPE_WEBHOOK_SECRET comes from the webhook endpoint you register in the
# Stripe dashboard pointing at <APP_URL>/api/billing/webhook — without it,
# Tenant.plan can never actually change, since the webhook is the only place
# that writes it. Without any of these three, billing UI still renders but
# every action returns a clear "not configured" error.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Vercel — powers custom domains (lib/vercelDomains.js, app/api/tenant/domain,
# proxy.js's host-based rewrite). VERCEL_API_TOKEN: https://vercel.com/account/tokens.
# VERCEL_PROJECT_ID: this project's Settings → General → Project ID.
# VERCEL_TEAM_ID is only needed if the project lives under a team scope, not
# a personal account. Without these, the custom-domain UI still renders but
# every action returns a clear "not configured" error — and even once
# they're set, a tenant actually running on their own domain requires that
# tenant to own a real domain and update its DNS records.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
# VERCEL_TEAM_ID=

# Follow-up reminders — the scheduled job at /api/cron/follow-ups that flags
# leads which have gone quiet (see vercel.json for the schedule, and
# lib/followUp.js for the rules). Vercel Cron sends this as a Bearer token
# automatically once it's set as an environment variable.
#
# The route REFUSES TO RUN when this is unset, rather than defaulting to
# open: it writes to every tenant's leads and takes no user session, so an
# unauthenticated version of it is not something to leave running by
# accident. Without it, nothing is ever flagged and the rest of the CRM is
# unaffected — generate one with `openssl rand -hex 32`.
CRON_SECRET=
