# MongoDB connection string (MongoDB Atlas recommended)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/crm-ai-agent

# Auth.js secret — generate your own with: npx auth secret
AUTH_SECRET=

# Anthropic API key — powers the AI agent (onboarding -> landing page copy
# + pipeline generation). Get one at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Only needed once Google sign-in is added (Phase 3)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Only needed once transactional email (verification/reset) is added
# RESEND_API_KEY=
